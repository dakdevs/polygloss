#include <stdio.h>
#include <string.h>

#include "store.h"

/* Records are saved through the store's own ops when it has them. */

int save_record(struct store *store, struct record *rec)
{
	int err;

	err = check_record(rec);
	if (err)
		return err;
	err = lock_store(store);
	if (err)
		return err;

	if (store->ops->save)
		err = store->ops->save(store, rec);
	else
		err = default_save(store, rec);
	return err;
}
